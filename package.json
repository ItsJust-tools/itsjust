{
  "name": "itsjust",
  "version": "1.0.0",
  "private": true,
  "description": "ItsJust — a collection of small, focused, single-purpose web tools.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ItsJust-tools/itsjust.git"
  },
  "homepage": "https://github.com/ItsJust-tools/itsjust#readme",
  "bugs": {
    "url": "https://github.com/ItsJust-tools/itsjust/issues"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "echo 'No ESLint config in this meta-repo; individual tools have their own lint setup.'",
    "format": "npx prettier --check .",
    "format:fix": "npx prettier --write .",
    "typecheck": "npx tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
